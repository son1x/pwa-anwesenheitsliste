# @DOMAIN@ (HTTPS) - PWA "Anwesenheitsliste" (PHP / SQLite).
# Erzeugt von pwa-anwesenheitsliste/deploy/vserver-setup.sh aus deploy/apache/anwesenheitsliste-ssl.conf.in -
# nicht von Hand ändern (Änderungen in der Vorlage, dann Setup erneut ausführen;
# vserver-pull.sh wendet diese Vorlage NIE an).
#
# Apache bedient die PWA direkt; PHP läuft über PHP-FPM (mpm_event bleibt für
# die anderen Seiten auf dem Server unverändert). Die .htaccess im Docroot
# leitet /api/* zu api.php um. Die Datenbank liegt AUSSERHALB des Docroots
# (data_dir in /etc/pwa-anwesenheitsliste.ini).
<VirtualHost *:@HTTPS_PORT@>
    ServerName @DOMAIN@

    SSLEngine on
    SSLCertificateFile @CERT@
    SSLCertificateKeyFile @CERT_KEY@
    @SSL_OPTS@

    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"

    DocumentRoot @DOCROOT@
    <Directory @DOCROOT@>
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted
        DirectoryIndex index.html
    </Directory>

    # Git-Daten, Deploy-Skripte und eine evtl. noch vorhandene alte
    # Datenbank-Ablage nie ausliefern - auch falls die .htaccess fehlt.
    <DirectoryMatch "^@DOCROOT@/(\.git|deploy|data)(/|$)">
        Require all denied
    </DirectoryMatch>
    <FilesMatch "^(\.|install\.sh$)">
        Require all denied
    </FilesMatch>

    ErrorLog @LOG_DIR@/anwesenheitsliste-error.log
    CustomLog @LOG_DIR@/anwesenheitsliste-access.log combined
</VirtualHost>
